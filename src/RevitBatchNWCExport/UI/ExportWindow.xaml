<Window x:Class="RevitBatchNWCExport.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RevitBatchNWCExport.UI"
        Title="NWC Экспорт"
        Width="1040" Height="660" MinWidth="780" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:RadioBoolConverter x:Key="RadioBool" />
        <SolidColorBrush x:Key="MutedBrush" Color="#616161" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Источник моделей: используется активная вкладка -->
        <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Revit Server">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ServerStatus}" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding HasServerStatus, Converter={StaticResource BoolToVisibility}}" />
                    <TreeView ItemsSource="{Binding ServerNodes}" BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="1,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServer}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource MutedBrush}"
                                               Margin="16,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}"
                                               Margin="16,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Папка с файлами">
                <DockPanel Margin="6">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                 VerticalContentAlignment="Center" Padding="4,3" />
                        <Button Grid.Column="1" Content="Обзор…" Margin="6,0,0,0" Click="BrowseSource_Click" />
                    </Grid>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Отметить все" Command="{Binding CheckAllFilesCommand}" Margin="0,0,6,0" />
                        <Button Content="Снять все" Command="{Binding UncheckAllFilesCommand}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding FilesStatus}" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListView ItemsSource="{Binding Files}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Файл" Width="380" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Изменён" Width="130" DisplayMemberBinding="{Binding ModifiedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Опции экспорта -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Экспорт" IsDefault="True" MinWidth="110" FontWeight="SemiBold" Click="Export_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <GroupBox Header="Параметры экспорта" Padding="8,4,8,8" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Каталог для NWC" Style="{StaticResource LabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="4,3" />
                        <Button Grid.Column="1" Content="Обзор…" Margin="6,0,0,0" Click="BrowseTarget_Click" />
                    </Grid>

                    <TextBlock Text="Имя вида для экспорта" Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />
                    <!-- Обе кнопки привязаны к одному свойству ViewNameExact; группа — по общему контейнеру -->
                    <StackPanel>
                        <RadioButton Content="Содержит" Margin="0,8,0,0"
                                     IsChecked="{Binding ViewNameExact, Mode=TwoWay, Converter={StaticResource RadioBool}, ConverterParameter=False}" />
                        <RadioButton Content="Точное соответствие" Margin="0,4,0,0"
                                     IsChecked="{Binding ViewNameExact, Mode=TwoWay, Converter={StaticResource RadioBool}, ConverterParameter=True}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MatchHint}" Style="{StaticResource HintStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>
        </DockPanel>
    </Grid>
</Window>
