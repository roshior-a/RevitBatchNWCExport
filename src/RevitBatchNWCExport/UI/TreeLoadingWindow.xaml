<Window x:Class="RevitBatchNWCExport.UI.TreeLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NWC Экспорт"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Загрузка моделей Revit Server…" FontWeight="SemiBold" />
        <TextBlock x:Name="ServersText" Foreground="#616161" Margin="0,4,0,0" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" Height="14" Margin="0,12,0,8" />
        <TextBlock x:Name="CountersText" Text="Папок: 0 · моделей: 0" Foreground="#616161" />
        <TextBlock x:Name="SlowText" Foreground="#EF6C00" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <Button Content="Отмена" HorizontalAlignment="Right" Padding="12,4" MinWidth="80" Margin="0,12,0,0"
                Click="Cancel_Click" />
    </StackPanel>
</Window>
